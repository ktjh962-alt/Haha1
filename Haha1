-- Keo icon bang cam ung
local dragging = false
local moved = false
local startInputPos
local startGuiPos
local activeInput

icon.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Touch
        or input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = true
        moved = false
        activeInput = input
        startInputPos = input.Position
        startGuiPos = icon.Position
    end
end)

icon.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Touch
        or input.UserInputType == Enum.UserInputType.MouseMovement then
        activeInput = input
    end
end)

local function updateDrag(input)
    if not dragging or not startInputPos then return end
    local delta = input.Position - startInputPos
    if math.abs(delta.X) > 5 or math.abs(delta.Y) > 5 then
        moved = true
    end
    icon.Position = UDim2.new(
        startGuiPos.X.Scale, startGuiPos.X.Offset + delta.X,
        startGuiPos.Y.Scale, startGuiPos.Y.Offset + delta.Y
    )
end

local UserInputService = game:GetService("UserInputService")
UserInputService.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.Touch
        or input.UserInputType == Enum.UserInputType.MouseMovement) then
        updateDrag(input)
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input == activeInput
        or input.UserInputType == Enum.UserInputType.Touch
        or input.UserInputType == Enum.UserInputType.MouseButton1 then
        if dragging then
            dragging = false
            if not moved then
                frame.Visible = not frame.Visible
            end
        end
    end
end)

minimize.Activated:Connect(function()
    frame.Visible = false
end)

-- Auto TP
local running = false
local session = 0

local function teleport(pos)
    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return false end
    root.CFrame = CFrame.new(pos)
    return true
end

start.Activated:Connect(function()
    if running then return end
    running = true
    session += 1
    local mySession = session

    task.spawn(function()
        while running and session == mySession do
            for i, house in ipairs(houses) do
                if not running or session ~= mySession then break end

                if teleport(house.pos) then
                    local finish = os.clock() + 3
                    while running and session == mySession
                        and os.clock() < finish do
                        status.Text = house.name .. " | Dung " ..
                            math.ceil(finish - os.clock()) .. "s"
                        task.wait(0.1)
                    end
                else
                    status.Text = "Khong tim thay nhan vat"
                    task.wait(1)
                end
            end
        end
        if session == mySession then
            status.Text = "Trang thai: STOP"
        end
    end)
end)

stop.Activated:Connect(function()
    running = false
    session += 1
    status.Text = "Trang thai: STOP"
end)

close.Activated:Connect(function()
    running = false
    session += 1
    gui:Destroy()
end)

